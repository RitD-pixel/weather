<title>Weather</title>

<style>
body {
    font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
}

h1 {
    text-align: center;
    color: white;
}

html, body {
    margin: 0;
    padding: 0;
    height: 100%;
}

.sky {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    background: linear-gradient(#4facfe, #00f2fe);
    overflow: hidden;
}

.cloud {
    width: 200px;
    height: 60px;
    background: white;
    border-radius: 50px;
    position: absolute;
    top: 50px;
    left: -200px;
    animation: moveCloud 20s linear infinite;
}

@keyframes moveCloud {
    from { left: -200px; }
    to { left: 100%; }
}
</style>
</head>

<body>

<h1>Weather</h1>

<div id="sky" class="sky">
    <div id="baseCloud" class="cloud"></div>
</div>

<script>
const base = document.getElementById("baseCloud");
const sky = document.getElementById("sky");

const cloudCount = 5;

for (let i = 0; i < cloudCount; i++) {
    const clone = base.cloneNode(true);

    const basePosition = (i / cloudCount) * 70;
    const randomOffset = Math.random() * 10;

    clone.style.top = (basePosition + randomOffset) + "%";
    clone.style.left = (-200 - Math.random() * 300) + "px";
    clone.style.animationDuration = (20 + Math.random() * 20) + "s";
    clone.style.animationDelay = Math.random() * 5 + "s";

    sky.appendChild(clone);
}
</script>
